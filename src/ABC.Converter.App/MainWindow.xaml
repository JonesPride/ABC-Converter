<Window x:Class="ABC.Converter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABC Converter"
        Width="1120"
        Height="780"
        MinWidth="840"
        MinHeight="620"
        Background="#FFF4F7FA"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">
  <Window.Resources>
    <Style x:Key="StandardButtonStyle"
           TargetType="Button">
      <Setter Property="MinHeight"
              Value="34" />
      <Setter Property="Padding"
              Value="14,6" />
      <Setter Property="Margin"
              Value="4,0" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Cursor"
              Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource StandardButtonStyle}">
      <Setter Property="Background"
              Value="#FF176B87" />
      <Setter Property="Foreground"
              Value="White" />
      <Setter Property="BorderBrush"
              Value="#FF176B87" />
    </Style>
    <Style x:Key="StatusCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="White" />
      <Setter Property="BorderBrush"
              Value="#FFD9E2E9" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="8" />
      <Setter Property="Padding"
              Value="14,10" />
      <Setter Property="Margin"
              Value="0,0,10,0" />
    </Style>
    <Style x:Key="CardCountStyle"
           TargetType="TextBlock">
      <Setter Property="FontSize"
              Value="24" />
      <Setter Property="FontWeight"
              Value="Bold" />
      <Setter Property="Foreground"
              Value="#FF15384A" />
    </Style>
    <Style x:Key="CardLabelStyle"
           TargetType="TextBlock">
      <Setter Property="FontSize"
              Value="12" />
      <Setter Property="Foreground"
              Value="#FF5C7180" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ABC Converter"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#FF15384A" />
        <TextBlock Text="Apple Books Comic Converter"
                   Margin="1,3,0,0"
                   Foreground="#FF5C7180" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center">
        <Button Content="Settings"
                Style="{StaticResource StandardButtonStyle}"
                IsEnabled="False"
                ToolTip="Settings arrive in the persistent queue update." />
        <Button Content="Help"
                Style="{StaticResource StandardButtonStyle}"
                IsEnabled="False"
                ToolTip="Help content arrives in a later update." />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Margin="0,0,0,16"
            Padding="18"
            BorderBrush="#FF8DB6C8"
            BorderThickness="2"
            CornerRadius="10"
            Background="#FFF2FAFD">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Drop CBZ files or folders here"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="#FF15384A" />
          <TextBlock Text="Folders are scanned recursively. Existing queue entries are skipped."
                     Margin="0,5,0,0"
                     Foreground="#FF5C7180" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="Add Comics"
                Command="{Binding AddFilesCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="18,0,0,0"
                MinWidth="126" />
      </Grid>
    </Border>

    <UniformGrid Grid.Row="2"
                 Columns="4"
                 Margin="0,0,-10,16">
      <Border Style="{StaticResource StatusCardStyle}">
        <StackPanel>
          <TextBlock Text="{Binding QueuedCount}"
                     Style="{StaticResource CardCountStyle}" />
          <TextBlock Text="Queued"
                     Style="{StaticResource CardLabelStyle}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatusCardStyle}">
        <StackPanel>
          <TextBlock Text="{Binding CompletedCount}"
                     Style="{StaticResource CardCountStyle}" />
          <TextBlock Text="Completed"
                     Style="{StaticResource CardLabelStyle}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatusCardStyle}">
        <StackPanel>
          <TextBlock Text="{Binding NeedsReviewCount}"
                     Style="{StaticResource CardCountStyle}" />
          <TextBlock Text="Needs Review"
                     Style="{StaticResource CardLabelStyle}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatusCardStyle}">
        <StackPanel>
          <TextBlock Text="{Binding FailedCount}"
                     Style="{StaticResource CardCountStyle}" />
          <TextBlock Text="Failed"
                     Style="{StaticResource CardLabelStyle}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Grid.Row="3"
            Background="White"
            BorderBrush="#FFD9E2E9"
            BorderThickness="1"
            CornerRadius="8"
            Padding="1">
      <DataGrid ItemsSource="{Binding Jobs}"
                SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#FFE8EEF2"
                BorderThickness="0"
                RowHeaderWidth="0"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Comic"
                              Binding="{Binding SourcePath}"
                              Width="2*" />
          <DataGridTextColumn Header="Series"
                              Binding="{Binding Series}"
                              Width="*" />
          <DataGridTextColumn Header="Status"
                              Binding="{Binding Status}"
                              Width="*" />
          <DataGridTemplateColumn Header="Progress"
                                  Width="1.25*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Margin="4,0">
                  <ProgressBar Value="{Binding Progress}"
                               Minimum="0"
                               Maximum="100"
                               Height="12"
                               VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                             Margin="0,0,4,0"
                             FontSize="10"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Output"
                              Binding="{Binding OutputPath}"
                              Width="2*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="4"
          Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Overall batch progress"
                   Margin="0,0,0,5"
                   FontWeight="SemiBold"
                   Foreground="#FF405866" />
        <ProgressBar Value="{Binding OverallProgress}"
                     Minimum="0"
                     Maximum="100"
                     Height="10" />
      </StackPanel>
      <TextBlock Grid.Column="1"
                 Text="{Binding OverallProgress, StringFormat={}{0:F0}%}"
                 Margin="12,18,0,0"
                 FontWeight="SemiBold"
                 Foreground="#FF405866" />
    </Grid>

    <Grid Grid.Row="5"
          Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Output location"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="#FF405866" />
      <TextBox Grid.Column="1"
               Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"
               Margin="12,0"
               MinHeight="34"
               Padding="8,5"
               VerticalContentAlignment="Center" />
      <Button Grid.Column="2"
              Content="Browse"
              Command="{Binding BrowseOutputCommand}"
              Style="{StaticResource StandardButtonStyle}"
              Margin="0" />
    </Grid>

    <Grid Grid.Row="6"
          Margin="0,16,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="Start"
                Command="{Binding StartCommand}"
                Style="{StaticResource PrimaryButtonStyle}" />
        <Button Content="Pause"
                Style="{StaticResource StandardButtonStyle}"
                IsEnabled="False"
                ToolTip="Pause scheduling is part of the persistent queue update." />
        <Button Content="Cancel Selected"
                Command="{Binding CancelSelectedCommand}"
                Style="{StaticResource StandardButtonStyle}" />
        <Button Content="Retry Selected"
                Command="{Binding RetrySelectedCommand}"
                Style="{StaticResource StandardButtonStyle}" />
        <Button Content="Retry All Failed"
                Command="{Binding RetryAllFailedCommand}"
                Style="{StaticResource StandardButtonStyle}" />
      </WrapPanel>

      <Expander Grid.Row="1"
                Header="Selected job details"
                Margin="0,14,0,0"
                IsExpanded="False">
        <Border Margin="0,8,0,0"
                Padding="14"
                Background="White"
                BorderBrush="#FFD9E2E9"
                BorderThickness="1"
                CornerRadius="8">
          <Grid DataContext="{Binding SelectedJob}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Source"
                       Margin="0,0,14,6"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       Text="{Binding SourcePath}"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1"
                       Text="Series"
                       Margin="0,0,14,6"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding Series}"
                       Margin="0,0,0,6" />
            <TextBlock Grid.Row="2"
                       Text="Status"
                       Margin="0,0,14,6"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding Status}"
                       Margin="0,0,0,6" />
            <TextBlock Grid.Row="3"
                       Text="Output"
                       Margin="0,0,14,6"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="3"
                       Grid.Column="1"
                       Text="{Binding OutputPath}"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="4"
                       Text="Error"
                       Margin="0,0,14,0"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="4"
                       Grid.Column="1"
                       Text="{Binding ErrorMessage}"
                       Foreground="#FFB42318"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Expander>
    </Grid>
  </Grid>
</Window>
